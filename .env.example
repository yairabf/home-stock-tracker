# Postgres container config, used by docker-compose.yml
POSTGRES_USER=home_stock
POSTGRES_PASSWORD=home_stock
POSTGRES_DB=home_stock_tracker
POSTGRES_PORT=5432

# Prisma connection string - keep in sync with the Postgres values above
DATABASE_URL="postgresql://home_stock:home_stock@localhost:5432/home_stock_tracker?schema=public"

# Private service credential used by agents for REST and MCP requests
API_AUTH_TOKEN="replace-with-a-long-random-token"

# Application runtime. NODE_ENV is optional; PORT defaults to 3000.
NODE_ENV=development
PORT=3000

# Minimum structured log severity: fatal, error, warn, log, debug, or verbose
LOG_LEVEL=log

# MCP is disabled by default. Set exactly true to expose the authenticated endpoint.
MCP_ENABLED=false

# LLM_PROVIDER defaults to openai; OPENAI_API_KEY is required for that provider.
LLM_PROVIDER=openai
OPENAI_API_KEY="replace-with-an-openai-api-key"

# Optional OpenAI model override; defaults to gpt-5.6-sol.
LLM_MODEL=gpt-5.6-sol

# Task providers default to openai. Jev matching and stock adapters are available.
# Keep matching on openai pending reviewed 37c evidence; stock requires 37e evaluation.
# PRODUCT_RESOLUTION_PROVIDER=openai
# STOCK_PREDICTION_PROVIDER=openai
# Optional transport credentials; construction/startup never calls TypeSafe.
# Supply a private key locally and a pinned model; omit settings rather than leave blank.
# TYPESAFE_API_KEY="replace-with-a-typesafe-api-key"
# JEV_MODEL=jev-1.13.0
# See docs/jev-integration.md for decision policies, transport, and verification commands.

# Daily stock estimation. Run only one scheduler-enabled service replica.
STOCK_WORKFLOW_ENABLED=true
STOCK_WORKFLOW_CRON="0 2 * * *"
STOCK_WORKFLOW_TIMEZONE=Asia/Jerusalem

# Published release Compose stack: defaults to latest; use sha-<full-commit-sha> to select a revision.
# IMAGE_TAG=latest
# Optional exact digest override, shared by app and migrations.
# IMAGE_REF=ghcr.io/yairabf/home-stock-tracker@sha256:<digest>
# APP_PORT=3000

# Independent metadata task selector; rollout defaults remain OpenAI.
# Keep independent task defaults until qualifying evidence is reviewed.
# See docs/jev-application-rollout.md for enablement and rollback.
PRODUCT_UNDERSTANDING_PROVIDER=openai
# Opt-in private request snapshots for evidence collection, before inference.
PRODUCT_UNDERSTANDING_CAPTURE_ENABLED=false

# Shelf-life policy routing stays OpenAI until task evaluation (38e).
SHELF_LIFE_POLICY_PROVIDER=openai

# Opt-in stock advice phase; enable only after reviewed task evaluation.
STOCK_WORKFLOW_ADVICE_ENABLED=false
STOCK_WORKFLOW_ADVICE_MAX_PRODUCTS=20
